{
  "name": "OBRIO · Світла",
  "dataColors": [
    "#4C63D6",
    "#A98307",
    "#029B9F",
    "#C2543A",
    "#9B5FD9",
    "#17A05F",
    "#2E7BC4",
    "#B84A7D"
  ],
  "good": "#17A05F",
  "neutral": "#8A8A96",
  "bad": "#C2543A",
  "maximum": "#1D2A6E",
  "center": "#9AA3E4",
  "minimum": "#E7EAFB",
  "null": "#F4F3FA",
  "background": "#FFFFFF",
  "secondaryBackground": "#F4F3FA",
  "tableAccent": "#4C63D6",
  "foreground": "#181818",
  "foregroundNeutralSecondary": "#5A5872",
  "foregroundNeutralTertiary": "#8A8A96",
  "textClasses": {
    "callout": { "fontSize": 34, "fontFace": "Segoe UI Bold", "color": "#181818" },
    "title": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#181818" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#181818" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5A5872" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E1F2" } }, "radius": 6 }],
        "visualHeader": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#181818" } },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left",
            "background": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "labels": [
          { "color": { "solid": { "color": "#181818" } }, "fontSize": 10, "fontFamily": "Segoe UI" }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#5A5872" } },
            "fontSize": 10,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#8A8A96" } },
            "fontSize": 10,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#EBEAF2" } },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#5A5872" } },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F7F7FB" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F7F7FB" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#181818" } }, "fontSize": 30, "fontFamily": "Segoe UI Bold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#8A8A96" } }, "fontSize": 10 }]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [{ "color": { "solid": { "color": "#181818" } }, "fontSize": 22 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#8A8A96" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#181818" } }, "fontSize": 10 }],
        "items": [{ "fontColor": { "solid": { "color": "#5A5872" } }, "fontSize": 10 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#EBEAF2" } }, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#181818" } }, "fontSize": 10, "bold": true }],
        "values": [{ "fontColor": { "solid": { "color": "#181818" } }, "fontSize": 10, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#FBFBFD" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#EBEAF2" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#181818" } }, "fontSize": 10, "bold": true }],
        "values": [{ "fontColor": { "solid": { "color": "#181818" } }, "fontSize": 10 }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3, "showMarker": true, "markerSize": 5 }]
      }
    },
    "scatterChart": {
      "*": {
        "bubbles": [{ "bubbleSize": -20 }]
      }
    }
  }
}
